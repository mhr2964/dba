# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Database
# Local dev: postgresql://dba:dba@localhost:5434/dba
# Railway: automatically set by Railway as DATABASE_URL
# Fly.io: set manually in fly secrets
DATABASE_URL=postgresql://user:password@host:port/dbname

# Optional: override log level (default: INFO)
# LOG_LEVEL=DEBUG

# Optional: Claude API key for columnist/awards/storyline article generation
# (awards_service.py, columnist_service.py, storyline_service.py, trade_cog.py).
# Features degrade gracefully (skip article generation) if unset.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
